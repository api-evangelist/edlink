            "url": {
              "raw": "{{baseUrl}}/graph/integrations/:id",
              "host": ["{{baseUrl}}"],
              "path": ["graph", "integrations", ":id"],
              "variable": [{ "key": "id", "value": "" }]
            },
            "description": "Returns metadata about the integration tied to the current access token."
          }
        },
        {
          "name": "List integrations (Meta API)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/meta/integrations",
