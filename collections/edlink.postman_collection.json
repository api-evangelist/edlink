{
  "info": {
    "name": "Edlink API",
    "description": "Edlink unified education-integration API (Graph API, SSO, sources/integrations, events) served under https://ed.link/api/v2 with Bearer token authentication.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{bearerToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://ed.link/api/v2"
    },
    {
      "key": "bearerToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "People",
      "item": [
        {
          "name": "List people",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/graph/people",
              "host": ["{{baseUrl}}"],
              "path": ["graph", "people"]
            },
            "description": "Returns a paginated list of all people shared with the integration."
          }
        },
        {
          "name": "Get a person",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/graph/people/:id",
              "host": ["{{baseUrl}}"],
              "path": ["graph", "people", ":id"],
              "variable": [{ "key": "id", "value": "" }]
            },
            "description": "Returns a single person by Edlink UUID."
          }
        }
      ]
    },
