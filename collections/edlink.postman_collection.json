    {
      "name": "Events",
      "item": [
        {
          "name": "List change events",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/graph/events",
              "host": ["{{baseUrl}}"],
              "path": ["graph", "events"]
            },
            "description": "Returns create, update, and delete events for incremental synchronization."
          }
        }
      ]
    },
    {
      "name": "SSO",
      "item": [
        {
          "name": "Get the authenticated user profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/my/profile",
              "host": ["{{baseUrl}}"],
              "path": ["my", "profile"]
            },
            "description": "Returns the profile of the user associated with a User Access Token."
          }
        },
        {
          "name": "Exchange an authorization code for an access token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "authorization_code" },
                { "key": "code", "value": "" },
                { "key": "client_id", "value": "" },
                { "key": "client_secret", "value": "" },
                { "key": "redirect_uri", "value": "" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/oauth2/token",
              "host": ["{{baseUrl}}"],
              "path": ["oauth2", "token"]
            },
            "description": "OAuth 2.0 token endpoint used during the SSO login flow."
          }
        }
      ]
    }
